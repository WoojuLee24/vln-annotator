# Personal secrets, sourced as environment variables so commands read them
# instead of hardcoding values. Copy to keys.env (gitignored) and fill in:
#   cp keys.env.example keys.env
#
# docker/run.sh and docker/serve.sh pass this file with --env-file, so it is
# never baked into the image. --env-file wants KEY=value, not `export KEY=`.

# Hugging Face — needed to download Cosmos-Reason2-* (gated=auto: accepting
# the terms on the model page grants access immediately, no review).
HF_TOKEN=

# Commercial backends. Only fill in the ones you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
